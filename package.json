{
	"name": "@borrowbetter/arpcsdk",
	"version": "0.1.1",
	"description": "Typed, agnostic client for FDR's ARPC DEX API — Achieve Resolution Partner Connect (Digital Enrollment Experience)",
	"author": "BorrowBetter",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BorrowBetter/arpcsdk.git"
	},
	"homepage": "https://github.com/BorrowBetter/arpcsdk#readme",
	"bugs": {
		"url": "https://github.com/BorrowBetter/arpcsdk/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"build": "pnpm codegen && tsup",
		"build:dist": "tsup",
		"codegen": "orval --config codegen.ts",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"typecheck:scripts": "tsc --noEmit --project scripts/tsconfig.json",
		"smoke": "tsx scripts/smoke.ts",
		"prepublishOnly": "pnpm build",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"format:check": "biome ci",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"dependencies": {
		"ky": "^1.7.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.0",
		"@types/node": "^22.10.5",
		"dotenv-flow": "^4.1.0",
		"orval": "^7.13.0",
		"tsup": "^8.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=18"
	}
}
