{
	"name": "@borrowbetter/arpcsdk",
	"version": "0.1.0",
	"description": "FDR ARPC DEX SDK — typed client + enrollment orchestration for Achieve Resolution Partner Connect (Digital Enrollment Experience)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BorrowBetter/arpcsdk.git"
	},
	"homepage": "https://github.com/BorrowBetter/arpcsdk#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "npm run codegen && tsup",
		"build:dist": "tsup",
		"codegen": "orval --config codegen.ts",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"typecheck:scripts": "tsc --noEmit --project scripts/tsconfig.json",
		"smoke": "tsx scripts/smoke.ts",
		"ui": "tsx scripts/server.ts",
		"prepublishOnly": "npm run build",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"format:check": "biome ci"
	},
	"dependencies": {
		"ky": "^1.7.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@types/node": "^22.10.5",
		"dotenv-flow": "^4.1.0",
		"orval": "^7.13.0",
		"tsup": "^8.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=18"
	}
}
