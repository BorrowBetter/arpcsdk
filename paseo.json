{
  "worktree": {
    "setup": [
      "git fetch origin main && git merge --ff-only origin/main || true",
      "cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env\" .env",
      "npm install",
      "npm run codegen"
    ]
  },
  "scripts": {
    "smoke": {
      "command": "npm run smoke"
    },
    "ui": {
      "command": "npm run ui"
    },
    "dev": {
      "command": "npm run dev"
    }
  }
}
