{
  "worktree": {
    "setup": [
      "git fetch origin main && git merge --ff-only origin/main || true",
      "cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env\" .env",
      "pnpm install",
      "pnpm codegen"
    ]
  },
  "scripts": {
    "smoke": {
      "command": "pnpm smoke"
    },
    "ui": {
      "command": "pnpm ui"
    },
    "dev": {
      "command": "pnpm dev"
    }
  }
}
